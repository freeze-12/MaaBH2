        "关卡等待时间": {
            "type": "input",
            "label": "关卡等待时间（毫秒）",
            "inputs": [
                {
                    "name": "毫秒",
                    "label": "关卡最多等待毫秒数",
                    "description": "默认 90000 = 90 秒。想要 2 分钟就填 120000",
                    "default": "90000",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "螺旋_等圈": {
                    "timeout": "{毫秒}"
                }
            }
        },
        "使用双倍体力": {
            "type": "switch",
            "label": "使用双倍体力",
            "description": "开启后，找不到「选择助战好友」（体力不足）时自动尝试兑换双倍体力（补充体力→有兑换则点兑换继续，无兑换则取消退出）",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "日常_有bonus": {
                            "on_error": [
                                "日常_补体力_点补充体力"
                            ]
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "日常_有bonus": {
                            "on_error": [
                                "日常_点战斗回判断"
                            ]
                        }
                    }
                }
            ]
        },
        "战斗界面方位选择": {
            "type": "select",
            "label": "战斗界面方位选择",
            "description": "优先从哪个方位寻找 bonus。选中方位排第一，其余按「左上→左下→右上」原序轮转",
            "default_case": "左上",
            "cases": [
                {
                    "name": "左上",
                    "pipeline_override": {
                        "备用_点活动": {
                            "next": [
                                "备用_进活动1"
                            ]
                        },
                        "备用_返回1": {
                            "next": [
                                "备用_进活动2"
                            ]
                        },
                        "备用_返回2": {
                            "next": [
                                "备用_下滑到顶"
                            ]
                        },
                        "备用_返回3": {
                            "next": [
                                "结束"
                            ]
                        }
                    }
                },
                {
                    "name": "左下",
                    "pipeline_override": {
                        "备用_点活动": {
                            "next": [
                                "备用_进活动2"
                            ]
                        },
                        "备用_返回1": {
                            "next": [
                                "备用_下滑到顶"
                            ]
                        },
                        "备用_返回2": {
                            "next": [
                                "备用_进活动1"
                            ]
                        },
                        "备用_返回3": {
                            "next": [
                                "结束"
                            ]
                        }
                    }
                },
                {
                    "name": "右上",
                    "pipeline_override": {
                        "备用_点活动": {
                            "next": [
                                "备用_下滑到顶"
                            ]
                        },
                        "备用_返回1": {
                            "next": [
                                "备用_进活动2"
                            ]
                        },
                        "备用_返回2": {
                            "next": [
                                "结束"
                            ]
                        },
                        "备用_返回3": {
                            "next": [
                                "备用_进活动1"
                            ]
                        }
                    }
                }
            ]
