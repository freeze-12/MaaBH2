{
    "interface_version": 2,
    "name": "MaaBh2",
    "description": "MaaBh2：崩坏学园2（国服 / com.miHoYo.HSoDv2Original，支持 UC 渠道、混服、腾讯服、B 服与测试服）",
    "version": "0.2.1",
    "license": "MIT",
    "controller": [
        {
            "name": "雷电模拟器",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "0. 测试连接（不操作）",
            "entry": "SmokeTest"
        },
        {
            "name": "1. 启动游戏",
            "entry": "StartGame",
            "description": "优先识别选项「启动渠道」选择的包，启动失败则进入轮询链依次尝试：国服 → 混服 → UC → 腾讯 → B服 → 测试服。",
            "option": [
                "启动渠道"
            ]
        },
        {
            "name": "2. 进入游戏（自选服务器）",
            "entry": "进入游戏_开始",
            "description": "可以选择的带下拉选项的区服请使用这个任务进入游戏，然后选「上次登录」。",
            "option": [
                "选择服务器"
            ]
        },
        {
            "name": "11. 进入游戏（国服/腾讯服/测试服）",
            "entry": "国服进入游戏_开始",
            "description": "不可选择、没有下拉框的区服请选择这个任务。"
        },
        {
            "name": "3. 清理弹窗",
            "entry": "清理弹窗_入口"
        },
        {
            "name": "4. 社团领取",
            "entry": "社团_开始"
        },
        {
            "name": "5. 日常活动清体力",
            "entry": "日常_开始",
            "description": "默认以刷亲密套装去打：主套是刷亲密的杂牌军，备用是割草刷装备的套装。需要把游戏内切换头像移到右上角，进地图后涉及角色切换，如菲米莉丝这种会弹窗导致识别失败的角色，记得关掉弹窗。",
            "option": [
                "战斗次数",
                "战斗界面方位选择",
                "使用双倍体力"
            ]
        },
        {
            "name": "9. 测试点击桌面图标",
            "entry": "OpenAppsFolder"
        },
        {
            "name": "6. 共鸣屋每日刷新",
            "entry": "共鸣屋_开始"
        },
        {
            "name": "7. 多元裂缝",
            "entry": "多元_开始",
            "description": "默认以刷亲密套装去打：主套是刷亲密的杂牌军，备用是割草刷装备的套装。需要把游戏内切换头像移到右上角，进地图后涉及角色切换，如菲米莉丝这种会弹窗导致识别失败的角色，记得关掉弹窗。",
            "option": [
                "使魔的爱",
                "虚轴之庭",
                "螺旋回廊",
                "螺旋回廊敌人",
                "关卡等待时间"
            ]
        },
        {
            "name": "8. 购买零时之种",
            "entry": "购买_零时开始"
        },
        {
            "name": "9. 使魔探险",
            "entry": "探险_开始"
        },
        {
            "name": "10. 每日每周任务奖励领取",
            "entry": "每日_开始"
        }
    ],
    "option": {
        "选择服务器": {
            "type": "select",
            "cases": [
                {
                    "name": "S2. 冰雪女王",
                    "pipeline_override": {
                        "进入游戏_选择服务器": {
                            "expected": "冰雪女王",
                            "target": [
                                957,
                                289
                            ]
                        }
                    }
                },
                {
                    "name": "S1. 纯白女神",
                    "pipeline_override": {
                        "进入游戏_选择服务器": {
                            "expected": "纯白女神",
                            "target": [
                                957,
                                451
                            ]
                        }
                    }
                },
                {
                    "name": "上次登录",
                    "pipeline_override": {
                        "进入游戏_选择服务器": {
                            "expected": "上次登录",
                            "target": [
                                957,
                                289
                            ]
                        }
                    }
                }
            ]
        },
        "战斗次数": {
            "type": "input",
            "label": "战斗次数",
            "inputs": [
                {
                    "name": "次数",
                    "label": "循环次数",
                    "description": "总共打几场，填 1~99 的整数。填 N 就总共打 N 场（从第一次识别点击 bonus 开始计数）。体力不足时会自动兑换双倍体力继续，直到打满 N 场或无法补体力为止",
                    "default": "8",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
  "pipeline_override": {
    "日常_有bonus": {
      "max_hit": "{次数}"
    }
  }
        },
        "启动渠道": {
            "type": "select",
            "cases": [
                {
                    "name": "国服（官方）",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv2Original"
                        }
                    }
                },
                {
                    "name": "UC 渠道",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv22144.uc"
                        }
                    }
                },
                {
                    "name": "混服",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv2.mix"
                        }
                    }
                },
                {
                    "name": "腾讯服",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv22144.tencent"
                        }
                    }
                },
                {
                    "name": "B 服",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv2BiliBiliRelease"
                        }
                    }
                },
                {
                    "name": "测试服",
                    "pipeline_override": {
                        "StartGame": {
                            "package": "com.miHoYo.HSoDv2Beta"
                        }
                    }
                }
            ]
        },
        "使魔的爱": {
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "使魔的爱_入口": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "使魔的爱_入口": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "虚轴之庭": {
            "type": "switch",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "虚轴之庭_入口": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "虚轴之庭_入口": {
                            "enabled": false
                        }
                    }
